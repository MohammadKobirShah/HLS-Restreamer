{
  "name": "hls-restreamer",
  "version": "2.0.0",
  "description": "High-performance HLS restreaming server without transcoding",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "npx pm2 start ecosystem.config.js",
    "pm2:stop": "npx pm2 stop ecosystem.config.js",
    "pm2:restart": "npx pm2 restart ecosystem.config.js",
    "pm2:logs": "npx pm2 logs",
    "cleanup": "python3 cleanup.py"
  },
  "dependencies": {
    "express": "^4.18.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "chalk": "^4.1.2",
    "node-cron": "^3.0.3",
    "lowdb": "^1.0.0",
    "pm2": "^5.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "hls",
    "streaming",
    "restreaming",
    "m3u8",
    "ffmpeg"
  ],
  "author": "Kobir Shah",
  "license": "MIT"
}
