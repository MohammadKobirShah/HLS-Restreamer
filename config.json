{
  "server": {
    "port": 3000,
    "host": "0.0.0.0"
  },
  "hls": {
    "segmentPath": "/tmp/hls",
    "segmentDuration": 2,
    "playlistLength": 16,
    "maxSegmentAge": 15,
    "cleanupInterval": 3,
    "useRamDisk": false
  },
  "ffmpeg": {
    "path": "/usr/bin/ffmpeg",
    "defaultOptions": [
      "-hide_banner",
      "-loglevel", "error",
      "-err_detect", "ignore_err"
    ]
  },
  "limits": {
    "maxChannels": 100,
    "maxBitrate": 10000,
    "connectionTimeout": 30000
  },
  "cloudflare": {
    "enabled": true,
    "tunnelName": "hls-restreamer"
  },
  "monitoring": {
    "enabled": true,
    "interval": 10
  }
}
